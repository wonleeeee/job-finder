#!/bin/sh
# Guard: nothing under data/ may ever be committed.
#
# The whole privacy model is one rule — "anything personal lives under data/"
# (DESIGN.md §8). This hook is what makes that rule hold even when a stray
# `git add -A` happens.
#
# Install:  git config core.hooksPath scripts/git-hooks

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^data/' | grep -v '^data/\.gitkeep$')

if [ -n "$staged" ]; then
    echo ""
    echo "  ✋ COMMIT BLOCKED — personal data must never be committed."
    echo ""
    echo "  The following staged paths are under data/:"
    echo "$staged" | sed 's/^/      /'
    echo ""
    echo "  Unstage them:   git restore --staged data/"
    echo ""
    echo "  If you genuinely need to commit something here, it does not belong"
    echo "  in data/ — move it to templates/ (sanitized example) instead."
    echo ""
    exit 1
fi

# Secondary guard: obvious secret files anywhere in the tree.
secrets=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env$|\.pem$|\.key$|_rsa$')
if [ -n "$secrets" ]; then
    echo ""
    echo "  ✋ COMMIT BLOCKED — this looks like a secret:"
    echo "$secrets" | sed 's/^/      /'
    echo ""
    exit 1
fi

# 허브 PII 가드 — 엔진은 공개 가능해야 한다 (허브 DESIGN.md 원칙 6)
hub_guard="$(git rev-parse --show-toplevel)/../../scripts/pii-guard.sh"
if [ -f "$hub_guard" ]; then sh "$hub_guard" || exit 1; fi

exit 0
